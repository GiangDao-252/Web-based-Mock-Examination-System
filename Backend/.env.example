# Sao chép thành .env và điền giá trị thật.
# SECRET_KEY và OTP_SECRET là hai khóa riêng, mỗi khóa ít nhất 32 ký tự.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=180

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=matchday
DB_USER=postgres
DB_PASSWORD=

# Chỉ cấu hình nhóm này nếu dùng đặt lại mật khẩu qua email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OTP_SECRET=
