    {
      "text": "Tính tích phân \\( \\int_0^1 x^2\\,dx \\).",
      "options": {
        "a": "\\( \\frac{1}{2} \\)",
        "b": "\\( \\frac{1}{3} \\)",
        "c": "\\( 1 \\)",
        "d": "\\( 2 \\)"
